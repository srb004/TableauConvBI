# Tableau (Personal Access Token auth)
TABLEAU_SERVER=
SITE_NAME=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
TABLEAU_DATASOURCE=

# Snowflake pass-through credentials for live data sources whose Snowflake
# connection is not embedded in Tableau. Optional -- leave both empty to
# keep the feature off.
SNOWFLAKE_CONN_USERNAME=
SNOWFLAKE_CONN_PASSWORD=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
